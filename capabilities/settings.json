{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "El panel de Ajustes puede leer y guardar los ajustes, gestionar atajos y cuentas, buscar actualizaciones y cerrarse.",
  "permissions": [
    "allow-get-settings",
    "allow-save-settings",
    "allow-check-updates",
    "allow-install-update",
    "allow-close-settings",
    "allow-pause-shortcuts",
    "allow-resume-shortcuts",
    "allow-add-account",
    "allow-switch-account",
    "allow-remove-account"
  ],
  "webviews": [
    "settings"
  ]
}
